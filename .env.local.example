# Copier ce fichier en « .env.local » puis renseigner les deux valeurs.
# On les trouve dans Supabase : Project Settings > API.
#
# .env.local n'est jamais versionné (voir .gitignore). Sur Vercel, ces
# mêmes variables se renseignent dans Project Settings > Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique
